{
  "name": "finnplay-test-task",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend developer test task for Finnplay",
  "license": "ISC",
  "author": "Aleksandr Shchilkin",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w client",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev": "concurrently -n server,client -c blue,green \"PORT=3010 npm run dev -w server\" \"npm run dev -w client\"",
    "dev:error-api": "CATALOG_ERROR=1 npm run dev",
    "dev:slow-api": "CATALOG_DELAY_MS=3000 npm run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
